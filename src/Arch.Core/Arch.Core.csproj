<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Arch.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared viewer assets (site.css, site.js, the vendored mermaid/3d-force-graph libs).
         Providers overlay their own provider-only assets on top — see SiteAssets.CopyTo. -->
    <None Include="Web\assets\**" CopyToOutputDirectory="PreserveNewest" Link="assets\%(RecursiveDir)%(Filename)%(Extension)" TargetPath="assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
