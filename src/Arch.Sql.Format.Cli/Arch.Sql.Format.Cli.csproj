<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sqlfmt-tsql</AssemblyName>
    <RootNamespace>Arch.Sql.Format.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sqlfmt-tsql</ToolCommandName>
    <PackageId>Arch.SqlFmt.Tsql</PackageId>
    <Version>1.0.0</Version>
    <Description>Standalone T-SQL formatter (ScriptDom-based, loss-safe, byte-identical-on-unparseable), extracted from Arch/ArchSql. Install as a dotnet global tool: dotnet tool install --global Arch.SqlFmt.Tsql</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arch.Sql.Format\Arch.Sql.Format.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
