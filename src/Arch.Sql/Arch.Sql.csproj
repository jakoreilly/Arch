<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>archsql</AssemblyName>
    <RootNamespace>Arch.Sql</RootNamespace>
    <!-- Must be false: Microsoft.Data.SqlClient requires ICU/globalization support and throws at
         connection time under invariant mode. All culture-sensitive operations in this codebase
         use explicit InvariantCulture/Ordinal comparisons, so disabling invariant mode does not
         change any output. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="161.9142.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- See the matching comment in Arch.Code.csproj. -->
    <InternalsVisibleTo Include="Arch.Cli" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arch.Core\Arch.Core.csproj" />
    <!-- See the matching comment in Arch.Code.csproj. -->
    <Using Include="Arch.Core.Web" />
  </ItemGroup>

  <ItemGroup>
    <!-- See the matching comment in Arch.Code.csproj — same layering, "assets-sql" instead. -->
    <None Include="Site\assets\**" CopyToOutputDirectory="PreserveNewest" Link="assets-sql\%(RecursiveDir)%(Filename)%(Extension)" TargetPath="assets-sql\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
