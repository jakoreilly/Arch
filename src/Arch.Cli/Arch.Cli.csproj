<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>arch</AssemblyName>
    <RootNamespace>Arch.Cli</RootNamespace>
    <!-- Reaches Arch.Sql (Microsoft.Data.SqlClient) via SqlAnalysisProvider/connect — Hard constraint 5. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Distributed as a dotnet global tool (plan.md Phase 3b) alongside the container image
         (Dockerfile at the repo root) — a consumer with the .NET 10 SDK already warm needs no
         image pull. ToolCommandName is "arch", matching AssemblyName above; that is a
         coincidence of naming, not a requirement — InternalsVisibleTo Include="arch" below
         matches on ASSEMBLY identity (AssemblyName), never on ToolCommandName or PackageId, so
         renaming either of those two would not break it. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>arch</ToolCommandName>
    <PackageId>Arch.Cli</PackageId>
    <Description>Arch: reads a folder and explains what's in it. Detects source code vs SQL
      scripts, analyses whichever applies, and writes a fully offline static site — dependency
      graphs, schema inventory, hotspots, CI quality gates. Install as a dotnet global tool:
      dotnet tool install --global Arch.Cli</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/jakoreilly/Arch</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jakoreilly/Arch</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>architecture;documentation;static-site;csharp;sql;dependency-graph;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arch.Core\Arch.Core.csproj" />
    <ProjectReference Include="..\Arch.Code\Arch.Code.csproj" />
    <ProjectReference Include="..\Arch.Sql\Arch.Sql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CrossLink is internal (Cli/ is not this product's public surface); Arch.Cli.Tests needs
         it directly to exercise the verified (Server+Catalog) join branch, which nothing reachable
         through Runner.Run can produce today — arch connect and arch <path> are separate, mutually
         exclusive entry points, so no CLI invocation ever builds a live-connected SqlModel and a
         code scan in the same run (see continue.md's Phase 6 findings). Arch.Cli.Tests has no
         AssemblyName override, so its assembly identity is its project name — no
         InternalsVisibleTo-matches-assembly-not-project-name trap here (see Phase 5 findings). -->
    <InternalsVisibleTo Include="Arch.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
