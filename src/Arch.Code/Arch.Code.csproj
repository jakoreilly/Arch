<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>archdiagram</AssemblyName>
    <RootNamespace>Arch.Code</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Arch.Cli's back-compat "arch code <args>" verb dispatches to Verbs.Run, which is
         internal by design (Cli/ is not this product's public surface). -->
    <InternalsVisibleTo Include="Arch.Cli" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arch.Core\Arch.Core.csproj" />
    <!-- Html (and later PageShell/Glossary/SiteAssets) were same-namespace types before the
         core was extracted and are referenced unqualified in 45 files. A global using keeps
         those call sites untouched, so the extraction diff stays readable. -->
    <Using Include="Arch.Core.Web" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provider-only assets (site.css/site.js/lib are Arch.Core's now). Land in their own
         build-output folder, not "assets" — Arch.Core's tree already claims that name via its
         own CopyToOutputDirectory items, and SiteAssets.CopyTo layers this one on top at
         generation time instead of relying on MSBuild to merge two same-named output dirs. -->
    <None Include="Site\assets\**" CopyToOutputDirectory="PreserveNewest" Link="assets-code\%(RecursiveDir)%(Filename)%(Extension)" TargetPath="assets-code\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
