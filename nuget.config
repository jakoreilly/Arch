<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins package restore to nuget.org for every machine that builds this repo.

  Without this file NuGet MERGES every nuget.config it finds walking up from the repo to the
  drive root, plus the per-user one (%APPDATA%\NuGet\NuGet.Config, ~/.nuget/NuGet/NuGet.Config).
  On a machine with an internal store configured there, that internal feed is silently added to
  the restore set and can serve a different xunit / SqlClient / Roslyn than nuget.org does -
  same id, same version, different bytes. Restore picks whichever source answers first, so the
  build stops being reproducible across machines and CI agents. That is the same claim
  "determinism is the product" (CLAUDE.md) makes about the generated site, applied one level
  down to the inputs.

  <clear /> cuts the inherited chain: only what is declared BELOW this line counts.

  If nuget.org is not reachable from a build agent, do not delete this file - swap the
  nuget.org URL for the internal mirror that proxies it, or add the internal feed as a second
  source and give it its own <package pattern="..."> below. See the commented block at the end.
-->
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    packageSourceMapping is also merged from parent configs, so it needs its own <clear />.
    With a mapping in force, a package id is only ever fetched from the sources whose patterns
    match it - adding an internal feed later cannot shadow a public package by accident, which
    is the dependency-confusion failure mode.
  -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!--
    A machine-level config can DISABLE a source by key. Clearing this stops an inherited
    "nuget.org = disabled" entry from turning the one source we declare into zero sources,
    which fails restore with a misleading "unable to find package" rather than a feed error.
  -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>

  <!--
    Visual Studio and some SDK installs register fallback folders holding pre-seeded packages.
    A fallback folder satisfies a dependency WITHOUT consulting any source and without writing a
    lock-file entry, so a package can resolve on one machine and 404 on a clean agent. Clear
    them so every machine resolves the same way.
  -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>

  <!--
    To add an internal store alongside nuget.org, uncomment and edit both blocks. Credentials
    belong in the agent's own config or NUGET_PLUGIN_PATHS / a credential provider - never in
    this file, which is tracked (CLAUDE.md: secrets never reach the output).

    <packageSources>
      <add key="internal" value="https://nuget.internal.example/v3/index.json" protocolVersion="3" />
    </packageSources>

    <packageSourceMapping>
      <packageSource key="internal">
        <package pattern="YourCo.*" />
      </packageSource>
    </packageSourceMapping>
  -->

</configuration>
