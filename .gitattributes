# Normalise to LF in the repository, and let each checkout decide for itself.
* text=auto

# These are read by cmd.exe and by Windows PowerShell 5.1, both of which want CRLF.
# A .cmd file with LF endings fails in ways that do not name the cause.
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Shell scripts must keep LF wherever they are checked out, or the shebang line
# carries a stray CR and the interpreter is reported as not found.
*.sh   text eol=lf

# Generated sites are one long line of inlined payload; diffing them is noise.
*.html linguist-generated=true

# Vendored viewer libraries (mermaid, 3d-force-graph) are third-party bundles and
# should not skew the repository's language statistics.
**/assets/lib/** linguist-vendored=true

# tools/golden.manifest is generated with LF and compared line-by-line against a freshly
# generated LF file. Left to `text=auto` it checks out CRLF wherever autocrlf is on, and
# every one of its 173 lines then reads as changed — the determinism gate failing for a
# reason that has nothing to do with determinism. Pinned, like the shell scripts above.
tools/golden.manifest text eol=lf
